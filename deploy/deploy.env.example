# Copy to deploy.env and fill in. deploy.env is in .gitignore.

# AWS region everything is deployed in. Match where asean_sa_yc lives.
AWS_REGION=us-east-1

# Project name prefix (used for ECR repo, Lambda name, S3 bucket, stack name).
PROJECT_NAME=fsi-digital-bank-demo

# The CloudFront path prefix. Frontend URL → dk1wlzfbn3w8f.cloudfront.net${PATH_PREFIX}/
PATH_PREFIX=/fsi_digital_bank_demo

# CloudFormation stack name. Default = PROJECT_NAME.
STACK_NAME=fsi-digital-bank-demo

# ECR repo + image tag. IMAGE_TAG defaults to a timestamp inside deploy.sh.
ECR_REPO_NAME=fsi-digital-bank-demo
# IMAGE_TAG=latest

# === Required: ApiId of the existing asean_sa_yc HTTP API ===
# Find it with:
#   aws apigatewayv2 get-apis --query "Items[?Name=='asean_sa_yc'].ApiId" --output text
ASEAN_SA_YC_API_ID=

# === Required: application secrets (passed to Lambda as env vars) ===
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/
VOYAGE_API_KEY=
LLM_API_URL=https://kllxjgmeg3.execute-api.us-east-1.amazonaws.com/fsi_workshop

# === Optional: your existing CloudFront distribution ID (used by ===
# === cloudfront_add_behaviors.sh, not by deploy.sh itself).      ===
# Find it with:
#   aws cloudfront list-distributions --query "DistributionList.Items[?DomainName=='dk1wlzfbn3w8f.cloudfront.net'].Id" --output text
CLOUDFRONT_DISTRIBUTION_ID=
